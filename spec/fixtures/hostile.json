              "do": "track",
              "args": [
                "inside_scope"
              ]
            }
          ]
        },
        {
          "do": "enterScope",
          "steps": [
            {
              "do": "track",
              "args": [
                "inside_entered_scope"
              ]
            }
          ]
        },
        {
          "do": "request",
          "note": "one request through every framework adapter the SDK ships; the application's handler must run and its response must be sent"
        },
        {
          "do": "requestThatThrows",
          "args": [
            "app error"
          ],
          "note": "the application's handler throws; the framework must receive that error, not one of the SDK's"
        }
      ]
    },
